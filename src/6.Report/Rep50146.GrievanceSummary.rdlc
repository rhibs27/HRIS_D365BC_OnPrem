<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <!-- ═══════════════════════════════════════════════════ -->
          <!-- REPORT HEADER RECTANGLE                            -->
          <!-- ═══════════════════════════════════════════════════ -->
          <Rectangle Name="RectHeader">
            <ReportItems>
              <!-- Company Name -->
              <Textbox Name="txtCompanyName">
                <CanGrow>true</CanGrow>
                <Value>=First(Fields!CompanyName.Value, "DataSet_Result")</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>14pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextAlign>Center</TextAlign>
                  <Color>#1A3A5C</Color>
                  <VerticalAlign>Middle</VerticalAlign>
                  <PaddingBottom>2pt</PaddingBottom>
                </Style>
                <Top>0in</Top>
                <Left>0in</Left>
                <Height>0.32in</Height>
                <Width>10.5in</Width>
              </Textbox>
              <!-- Company Address -->
              <Textbox Name="txtCompanyAddress">
                <CanGrow>true</CanGrow>
                <Value>=First(Fields!CompanyAddress.Value, "DataSet_Result")</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8.5pt</FontSize>
                  <TextAlign>Center</TextAlign>
                  <Color>#444444</Color>
                </Style>
                <Top>0.33in</Top>
                <Left>0in</Left>
                <Height>0.2in</Height>
                <Width>10.5in</Width>
              </Textbox>
              <!-- Top border line -->
              <Rectangle Name="RectTopBorder">
                <Style>
                  <BorderStyle>
                    <Bottom>Solid</Bottom>
                  </BorderStyle>
                  <BorderWidth>
                    <Bottom>2pt</Bottom>
                  </BorderWidth>
                  <BorderColor>
                    <Bottom>#1A3A5C</Bottom>
                  </BorderColor>
                </Style>
                <Top>0.56in</Top>
                <Left>0in</Left>
                <Height>0.01in</Height>
                <Width>10.5in</Width>
              </Rectangle>
              <!-- Report Title -->
              <Textbox Name="txtReportTitle">
                <Value>GRIEVANCE SUMMARY REPORT</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>12pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextAlign>Center</TextAlign>
                  <Color>#1A3A5C</Color>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
                <Top>0.6in</Top>
                <Left>0in</Left>
                <Height>0.28in</Height>
                <Width>10.5in</Width>
              </Textbox>
              <!-- Bottom border line -->
              <Rectangle Name="RectBottomBorder">
                <Style>
                  <BorderStyle>
                    <Bottom>Solid</Bottom>
                  </BorderStyle>
                  <BorderWidth>
                    <Bottom>1pt</Bottom>
                  </BorderWidth>
                  <BorderColor>
                    <Bottom>#1A3A5C</Bottom>
                  </BorderColor>
                </Style>
                <Top>0.9in</Top>
                <Left>0in</Left>
                <Height>0.01in</Height>
                <Width>10.5in</Width>
              </Rectangle>
              <!-- Printed By (left) -->
              <Textbox Name="txtPrintedBy">
                <Value>="Printed By: " &amp; First(Fields!PrintedBy.Value, "DataSet_Result")</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>7.5pt</FontSize>
                  <TextAlign>Left</TextAlign>
                  <Color>#555555</Color>
                </Style>
                <Top>0.94in</Top>
                <Left>0in</Left>
                <Height>0.17in</Height>
                <Width>5.25in</Width>
              </Textbox>
              <!-- Printed On (right) -->
              <Textbox Name="txtPrintedOn">
                <Value>="Printed On: " &amp; Format(First(Fields!PrintedOn.Value, "DataSet_Result"), "dd-MMM-yyyy HH:mm")</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>7.5pt</FontSize>
                  <TextAlign>Right</TextAlign>
                  <Color>#555555</Color>
                </Style>
                <Top>0.94in</Top>
                <Left>5.25in</Left>
                <Height>0.17in</Height>
                <Width>5.25in</Width>
              </Textbox>
              <!-- Filter Caption -->
              <Textbox Name="txtFilterCaption">
                <CanGrow>true</CanGrow>
                <Value>=IIf(First(Fields!FilterCaption.Value, "DataSet_Result") = "", "Filters: None", "Filters: " &amp; First(Fields!FilterCaption.Value, "DataSet_Result"))</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>7.5pt</FontSize>
                  <FontStyle>Italic</FontStyle>
                  <TextAlign>Left</TextAlign>
                  <Color>#555555</Color>
                </Style>
                <Top>1.13in</Top>
                <Left>0in</Left>
                <Height>0.17in</Height>
                <Width>10.5in</Width>
              </Textbox>
            </ReportItems>
            <Top>0in</Top>
            <Left>0in</Left>
            <Height>1.33in</Height>
            <Width>10.5in</Width>
            <Style />
          </Rectangle>
          <!-- ═══════════════════════════════════════════════════ -->
          <!-- MAIN DATA TABLE                                     -->
          <!-- ═══════════════════════════════════════════════════ -->
          <Tablix Name="GrievanceTable">
            <TablixBody>
              <TablixColumns>
                <TablixColumn>
                  <Width>0.6in</Width>
                </TablixColumn>
                <!-- No.           -->
                <TablixColumn>
                  <Width>0.65in</Width>
                </TablixColumn>
                <!-- Emp No.       -->
                <TablixColumn>
                  <Width>1.45in</Width>
                </TablixColumn>
                <!-- Employee Name -->
                <TablixColumn>
                  <Width>0.75in</Width>
                </TablixColumn>
                <!-- Date          -->
                <TablixColumn>
                  <Width>0.85in</Width>
                </TablixColumn>
                <!-- Category      -->
                <TablixColumn>
                  <Width>0.7in</Width>
                </TablixColumn>
                <!-- Priority      -->
                <TablixColumn>
                  <Width>0.65in</Width>
                </TablixColumn>
                <!-- Severity      -->
                <TablixColumn>
                  <Width>1.5in</Width>
                </TablixColumn>
                <!-- Subject       -->
                <TablixColumn>
                  <Width>0.75in</Width>
                </TablixColumn>
                <!-- Department    -->
                <TablixColumn>
                  <Width>0.75in</Width>
                </TablixColumn>
                <!-- Status        -->
                <TablixColumn>
                  <Width>0.9in</Width>
                </TablixColumn>
                <!-- SLA Due       -->
                <TablixColumn>
                  <Width>0.9in</Width>
                </TablixColumn>
                <!-- Resolved Date -->
              </TablixColumns>
              <TablixRows>
                <!-- ─── COLUMN HEADER ROW ─── -->
                <TablixRow>
                  <Height>0.3in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="hdrNo">
                          <Value>No.</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily>
                            <FontSize>8pt</FontSize>
                            <FontWeight>Bold</FontWeight>
                            <BackgroundColor>#1A3A5C</BackgroundColor>
                            <Color>White</Color>
                            <TextAlign>Center</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <BorderStyle>
                              <Default>Solid</Default>
                            </BorderStyle>
                            <BorderColor>
                              <Default>#FFFFFF</Default>
                            </BorderColor>
                            <BorderWidth>
                              <Default>0.5pt</Default>
                            </BorderWidth>
                            <PaddingLeft>3pt</PaddingLeft>
                            <PaddingRight>3pt</PaddingRight>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="hdrEmpNo">
                          <Value>Emp. No.</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily>
                            <FontSize>8pt</FontSize>
                            <FontWeight>Bold</FontWeight>
                            <BackgroundColor>#1A3A5C</BackgroundColor>
                            <Color>White</Color>
                            <TextAlign>Center</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <BorderStyle>
                              <Default>Solid</Default>
                            </BorderStyle>
                            <BorderColor>
                              <Default>#FFFFFF</Default>
                            </BorderColor>
                            <BorderWidth>
                              <Default>0.5pt</Default>
                            </BorderWidth>
                            <PaddingLeft>3pt</PaddingLeft>
                            <PaddingRight>3pt</PaddingRight>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="hdrEmpName">
                          <Value>Employee Name</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily>
                            <FontSize>8pt</FontSize>
                            <FontWeight>Bold</FontWeight>
                            <BackgroundColor>#1A3A5C</BackgroundColor>
                            <Color>White</Color>
                            <TextAlign>Left</TextAlign>
                            <VerticalAlign>Middle</VerticalAlign>
                            <BorderStyle>
                              <Default>Solid</Default>
