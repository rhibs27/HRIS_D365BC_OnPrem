                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>This has reference to your application dated </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Fields!RequestedDate.Value</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <Format>MMMM d, yyyy</Format>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> for acceptance of your resignation from the services of the Bank. Please note that the same is hereby accepted with effect from be </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Fields!EffectiveDate.Value</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <Format>d MMMM, yyyy</Format>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>. Your last working day will be </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Fields!LastWorkingDay.Value</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <Format>d MMMM, yyyy</Format>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>General</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value />
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>General</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>You are required to hand over your charges to your immediate successor and deposit back the identity card &amp; other items of the Bank with you, if any, and obtain Clearance Certificate from the concerned departments for settlement of your dues.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>General</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value />
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>General</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>We take this opportunity to thank you for your services to this Bank and wish you all success in your future endeavors.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Normal</FontWeight>
