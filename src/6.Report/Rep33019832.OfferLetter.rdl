                                                <TextRuns>
                                                  <TextRun>
                                                    <Value EvaluationMode="Auto">                                a) Basic Salary                    Rs.  </Value>
                                                    <Style>
                                                      <FontStyle>Normal</FontStyle>
                                                      <FontSize>9pt</FontSize>
