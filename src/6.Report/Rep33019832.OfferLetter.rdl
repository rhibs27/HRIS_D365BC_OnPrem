                                    <TablixCells>
                                      <TablixCell>
                                        <CellContents>
                                          <Textbox Name="Textbox71">
                                            <CanGrow>true</CanGrow>
                                            <KeepTogether>true</KeepTogether>
                                            <Paragraphs>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value EvaluationMode="Auto">Please indicate your acceptance by signing and returning the duplicate of this letter, within 7 days from the date of this letter, failing which we shall treat it as your non-acceptance of our offer.</Value>
                                                    <Style>
                                                      <FontStyle>Normal</FontStyle>
                                                      <FontSize>9pt</FontSize>
                                                      <FontWeight>Normal</FontWeight>
                                                      <TextDecoration>None</TextDecoration>
                                                      <Color>#000000</Color>
                                                    </Style>
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value EvaluationMode="Auto" />
                                                    <Style>
                                                      <FontStyle>Normal</FontStyle>
                                                      <FontSize>9pt</FontSize>
                                                      <FontWeight>Normal</FontWeight>
                                                      <TextDecoration>None</TextDecoration>
                                                      <Color>#000000</Color>
                                                    </Style>
                                                  </TextRun>
                                                </TextRuns>
                                                <Style>
                                                  <TextAlign>Left</TextAlign>
                                                  <LineHeight>6pt</LineHeight>
                                                </Style>
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value EvaluationMode="Auto">I look forward to welcoming you in the NIC ASIA Bank family and working closely with you and wish you every success in your career with us.</Value>
                                                    <Style>
                                                      <FontStyle>Normal</FontStyle>
                                                      <FontSize>9pt</FontSize>
                                                      <FontWeight>Normal</FontWeight>
                                                      <TextDecoration>None</TextDecoration>
                                                      <Color>#000000</Color>
                                                    </Style>
