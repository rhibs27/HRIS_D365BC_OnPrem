                                            <KeepTogether>true</KeepTogether>
                                            <Paragraphs>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value EvaluationMode="Auto">Internal vacancy should be announced via country circular through iZone3 mentioning the title of the job, job description and deadline of the vacancy. Deadline of the Vacancy shall be decided by CEO and the maximum number of days to close an internal vacancy shall be 1 month or as decided by CEO."</Value>
                                                    <Style>
