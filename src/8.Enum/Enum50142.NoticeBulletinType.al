enum 50142 "Notice Bulletin Type"
{
    Extensible = true;

    value(0; "")
    {
        Caption = '';
    }
    value(1; All)
    {
        Caption = 'All';
    }
    value(2; Province)
    {
        Caption = 'Province';
    }
    value(3; Branch)
    {
        Caption = 'Branch';
    }
    value(4; Department)
    {
        Caption = 'Department';
    }
}
