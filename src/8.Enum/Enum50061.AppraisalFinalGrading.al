enum 50061 "Appraisal Final Grading"
{
    Extensible = true;

    value(0; "")
    {
        Caption = '';
    }
    value(1; Excellent)
    {
        Caption = 'Excellent';
    }
    value(2; "Very Good")
    {
        Caption = 'Very Good';
    }
    value(3; Good)
    {
        Caption = 'Good';
    }
    value(4; Satisfactory)
    {
        Caption = 'Satisfactory';
    }
    value(5; UnSatisfactory)
    {
        Caption = 'UnSatisfactory';
    }
}
